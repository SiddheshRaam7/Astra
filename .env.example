# Leave integrations unset to run the isolated, synthetic demo locally.
APP_BASE_URL=http://127.0.0.1:3000
# Tiger Data PostgreSQL connection URL; required on Vercel for durable storage.
DATABASE_URL=
# Auth0 regular web application: callback /auth/callback; logout APP_BASE_URL
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# At least 32 random characters. Required for hosted demo and AI confirmation signing.
SESSION_SECRET=
# Set false to require Auth0 login. Never mix demo and real bank data.
DEMO_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Sandbox only. Access tokens encrypted server-side using TOKEN_ENCRYPTION_KEY.
PLAID_CLIENT_ID=
PLAID_SECRET=
TOKEN_ENCRYPTION_KEY=
